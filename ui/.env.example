# API backend (Aegra server)
API_BASE_URL=http://localhost:2026

# Better Auth — must match your PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Better Auth secret — must be at least 32 characters
# Generate: npx auth secret
BETTER_AUTH_SECRET=change-me-to-a-32-char-secret

# Better Auth base URL — where the UI is served from
ORIGIN=http://localhost:5173
