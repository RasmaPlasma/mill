DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_ENABLED=true
PORT=2026
HOST=0.0.0.0

# LLM provider API keys — agent model field uses provider:model format
# (e.g., nvidia:nvidia/... uses NVIDIA_API_KEY, fireworks:accounts/... uses FIREWORKS_API_KEY)
NVIDIA_API_KEY=
# FIREWORKS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

OTEL_TARGETS=PHOENIX
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PLATFORM_MASTER_KEY=

# Sandbox service — shared API key for platform-to-sandbox auth
SANDBOX_SERVICE_URL=http://sandbox-service:8090
SANDBOX_API_KEY=

# ---------------------------------------------------------------------------
# Sandbox Container Runtime (optional)
# ---------------------------------------------------------------------------
# Runtime for agent sandbox containers. Options:
#   runc          - Default Docker runtime (strongest compatibility)
#   runsc         - gVisor (userspace kernel isolation; requires host setup)
#   sysbox-runc   - Sysbox (hardened containers without VMs; requires host setup)
# DOCKER_RUNTIME=

# DNS servers for sandbox containers. REQUIRED when using gVisor (runsc)
# because gVisor's isolated netstack cannot reach Docker's embedded DNS at
# 127.0.0.11 on custom bridge networks. Comma-separated.
# Ignored unless explicitly set.
# SANDBOX_DNS_SERVERS=8.8.8.8,1.1.1.1
